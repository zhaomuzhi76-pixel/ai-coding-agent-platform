{
  "name": "biancheng-ai",
  "displayName": "Biancheng AI Coding",
  "description": "Industrial AI coding assistant: LSP + platform commands",
  "version": "0.1.0",
  "publisher": "biancheng",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Machine Learning"],
  "activationEvents": [
    "onLanguage:python",
    "onCommand:biancheng.createSession",
    "onCommand:biancheng.propose",
    "onCommand:biancheng.approve",
    "onCommand:biancheng.apply",
    "onCommand:biancheng.verify",
    "onCommand:biancheng.learn"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "biancheng.createSession", "title": "Biancheng: Create Session" },
      { "command": "biancheng.propose", "title": "Biancheng: Propose Change" },
      { "command": "biancheng.approve", "title": "Biancheng: Approve Proposal" },
      { "command": "biancheng.apply", "title": "Biancheng: Apply Proposal" },
      { "command": "biancheng.verify", "title": "Biancheng: Verify Proposal" },
      { "command": "biancheng.learn", "title": "Biancheng: Learn From Proposal" }
    ],
    "configuration": {
      "title": "Biancheng AI",
      "properties": {
        "biancheng.serverCommand": {
          "type": "string",
          "default": "python",
          "description": "Command to launch the LSP server"
        },
        "biancheng.serverArgs": {
          "type": "array",
          "default": ["-m", "backend.lsp.cli"],
          "description": "Arguments for the LSP server"
        },
        "biancheng.apiBase": {
          "type": "string",
          "default": "http://localhost:8000/api/platform",
          "description": "Platform REST endpoint base"
        },
        "biancheng.model": {
          "type": "string",
          "default": "qwen-max",
          "description": "Selected LLM model (user choice)"
        },
        "biancheng.locale": {
          "type": "string",
          "default": "zh-CN",
          "description": "UI language"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
